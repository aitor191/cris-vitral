---
import '../styles/global.css'

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Cris Vitral — Vitrales únicos, hechos en casa',
  description = 'Taller artesanal de arte vitral hecho a mano. Piezas únicas, asequibles, con envío a toda España.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Lato:wght@300;400;700&family=Special+Elite&family=Caveat:wght@400;500;600&family=Petit+Formal+Script&display=swap" rel="stylesheet" />
</head>
<body class="bg-kraft text-ink font-body font-normal text-base leading-relaxed antialiased">
  <slot />

  <script>
    const nav = document.getElementById('nav');
    const onScroll = () => {
      if (nav) {
        if (window.scrollY > 8) nav.classList.add('is-scrolled');
        else nav.classList.remove('is-scrolled');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</body>
</html>

<style is:global>
  :root {
    --container: 1180px;
    --container-tight: 880px;
    --gutter: clamp(1.25rem, 4vw, 2.5rem);
    --section-py: clamp(5rem, 10vw, 8rem);
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    background-image:
      radial-gradient(ellipse 1200px 800px at 10% 0%, rgba(139, 99, 64, 0.04), transparent 60%),
      radial-gradient(ellipse 1000px 700px at 90% 100%, rgba(139, 99, 64, 0.05), transparent 60%);
    background-attachment: fixed;
    text-rendering: optimizeLegibility;
  }

  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
  p { margin: 0; }
  h1, h2, h3, h4 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .container {
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .container--tight { max-width: var(--container-tight); }

  /* Eyebrow label */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-type);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--color-green);
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
  .eyebrow::before {
    content: '';
    width: 24px;
    height: 1px;
    background: var(--color-green);
  }

  /* Section head */
  .section__head {
    text-align: center;
    margin-bottom: 4.5rem;
  }
  .section__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: var(--color-ink);
  }
  .section__title em {
    font-style: italic;
    color: var(--color-green);
  }
  .section__intro {
    max-width: 520px;
    margin: 0 auto;
    color: var(--color-ink-soft);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.75rem;
    font-family: var(--font-type);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.25s ease;
  }
  .btn--primary {
    background: var(--color-green);
    color: var(--color-kraft);
  }
  .btn--primary:hover {
    background: var(--color-green-deep);
    transform: translateY(-1px);
  }
  .btn--ghost {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-brown);
  }
  .btn--ghost:hover {
    background: rgba(139, 99, 64, 0.08);
    border-color: var(--color-brown-deep);
  }
  .btn__arrow {
    width: 14px; height: 10px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    transition: transform 0.25s ease;
  }
  .btn:hover .btn__arrow { transform: translateX(3px); }

  /* Polaroid base */
  .polaroid {
    background: var(--color-paper);
    padding: 14px 14px 0;
    box-shadow:
      0 1px 0 rgba(58, 46, 26, 0.04),
      0 16px 28px -14px rgba(58, 46, 26, 0.22);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease;
    position: relative;
    display: block;
  }
  .polaroid:hover {
    transform: translateY(-6px) rotate(0deg) !important;
    box-shadow: 0 1px 0 rgba(58, 46, 26, 0.04), 0 28px 40px -16px rgba(58, 46, 26, 0.3);
  }
  .polaroid--r1 { transform: rotate(-1.5deg); }
  .polaroid--r2 { transform: rotate(1.2deg); }
  .polaroid--r3 { transform: rotate(-0.8deg); }
  .polaroid--r4 { transform: rotate(2deg); }
  .polaroid--w3 { grid-column: span 3; }
  .polaroid--w4 { grid-column: span 4; }
  .polaroid--w5 { grid-column: span 5; }
  .polaroid--w6 { grid-column: span 6; }
  .polaroid--w7 { grid-column: span 7; }
  .offset-down { margin-top: 3rem; }
  .offset-down-2 { margin-top: 5rem; }

  @media (max-width: 900px) {
    .polaroid--w3, .polaroid--w4, .polaroid--w5, .polaroid--w6, .polaroid--w7 {
      grid-column: span 6;
    }
    .offset-down, .offset-down-2 { margin-top: 0; }
  }
  @media (max-width: 560px) {
    .polaroid--w3, .polaroid--w4, .polaroid--w5, .polaroid--w6, .polaroid--w7 {
      grid-column: span 12;
    }
  }

  /* Vitral CSS backgrounds */
  .vit-1 {
    background:
      linear-gradient(135deg, rgba(224, 169, 74, 1), rgba(200, 146, 58, 0.95) 35%, rgba(92, 138, 63, 0.95) 70%, rgba(42, 79, 21, 1)),
      radial-gradient(circle at 30% 40%, rgba(255, 235, 175, 1), transparent 35%);
    position: relative;
  }
  .vit-1::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent 49%, rgba(40, 30, 15, 0.8) 49%, rgba(40, 30, 15, 0.8) 51%, transparent 51%),
      linear-gradient(0deg, transparent 32%, rgba(40, 30, 15, 0.7) 32%, rgba(40, 30, 15, 0.7) 33%, transparent 33%),
      linear-gradient(0deg, transparent 65%, rgba(40, 30, 15, 0.7) 65%, rgba(40, 30, 15, 0.7) 66%, transparent 66%);
  }
  .vit-2 {
    background: radial-gradient(circle at 50% 50%, rgba(255, 235, 175, 1) 0%, rgba(224, 169, 74, 1) 18%, rgba(160, 74, 88, 0.95) 35%, rgba(74, 111, 168, 0.95) 65%, rgba(20, 35, 65, 1) 100%);
    position: relative;
  }
  .vit-2::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 50%, transparent 17%, rgba(40, 30, 15, 0.8) 17%, rgba(40, 30, 15, 0.8) 19%, transparent 19%),
      conic-gradient(from 0deg at 50% 50%,
        transparent 0deg, transparent 28deg, rgba(40, 30, 15, 0.7) 28deg, rgba(40, 30, 15, 0.7) 32deg,
        transparent 32deg, transparent 88deg, rgba(40, 30, 15, 0.7) 88deg, rgba(40, 30, 15, 0.7) 92deg,
        transparent 92deg, transparent 148deg, rgba(40, 30, 15, 0.7) 148deg, rgba(40, 30, 15, 0.7) 152deg,
        transparent 152deg, transparent 208deg, rgba(40, 30, 15, 0.7) 208deg, rgba(40, 30, 15, 0.7) 212deg,
        transparent 212deg, transparent 268deg, rgba(40, 30, 15, 0.7) 268deg, rgba(40, 30, 15, 0.7) 272deg,
        transparent 272deg, transparent 328deg, rgba(40, 30, 15, 0.7) 328deg, rgba(40, 30, 15, 0.7) 332deg,
        transparent 332deg);
  }
  .vit-3 {
    background: linear-gradient(180deg,
      rgba(255, 235, 175, 1) 0%,
      rgba(224, 169, 74, 0.95) 25%,
      rgba(160, 74, 88, 0.9) 45%,
      rgba(92, 138, 63, 0.95) 65%,
      rgba(42, 79, 21, 1) 100%);
    position: relative;
  }
  .vit-3::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 24%, rgba(40, 30, 15, 0.75) 24%, rgba(40, 30, 15, 0.75) 26%, transparent 26%),
      linear-gradient(180deg, transparent 64%, rgba(40, 30, 15, 0.75) 64%, rgba(40, 30, 15, 0.75) 66%, transparent 66%),
      linear-gradient(90deg, transparent 49%, rgba(40, 30, 15, 0.6) 49%, rgba(40, 30, 15, 0.6) 51%, transparent 51%);
  }
  .vit-4 {
    background: conic-gradient(from 45deg at 50% 50%,
      rgba(160, 74, 88, 1),
      rgba(224, 169, 74, 0.95),
      rgba(255, 235, 175, 1),
      rgba(160, 74, 88, 1),
      rgba(110, 35, 50, 1),
      rgba(160, 74, 88, 1));
    position: relative;
  }
  .vit-4::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(45deg, transparent 49%, rgba(40, 30, 15, 0.75) 49%, rgba(40, 30, 15, 0.75) 51%, transparent 51%),
      linear-gradient(-45deg, transparent 49%, rgba(40, 30, 15, 0.75) 49%, rgba(40, 30, 15, 0.75) 51%, transparent 51%);
  }
  .vit-5 {
    background: linear-gradient(120deg,
      rgba(122, 175, 79, 1) 0%,
      rgba(92, 138, 63, 1) 30%,
      rgba(255, 235, 175, 0.9) 50%,
      rgba(224, 169, 74, 0.9) 70%,
      rgba(160, 74, 88, 0.85) 100%);
    position: relative;
  }
  .vit-5::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 25% at 30% 30%, rgba(15, 25, 5, 0.5), transparent 60%),
      linear-gradient(135deg, transparent 49%, rgba(40, 30, 15, 0.7) 49%, rgba(40, 30, 15, 0.7) 51%, transparent 51%);
  }
  .vit-6 {
    background: linear-gradient(135deg, rgba(74, 111, 168, 1), rgba(43, 74, 122, 1));
    position: relative;
  }
  .vit-6::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 25% 25%, rgba(255, 235, 175, 1), rgba(224, 169, 74, 0.9) 40%, transparent 50%),
      radial-gradient(circle at 75% 25%, rgba(160, 74, 88, 0.95), transparent 50%),
      radial-gradient(circle at 25% 75%, rgba(122, 175, 79, 0.95), transparent 50%),
      radial-gradient(circle at 75% 75%, rgba(255, 235, 175, 0.95), rgba(224, 169, 74, 0.85) 40%, transparent 50%);
  }
  .vit-6::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent 49%, rgba(40, 30, 15, 0.85) 49%, rgba(40, 30, 15, 0.85) 51%, transparent 51%),
      linear-gradient(0deg, transparent 49%, rgba(40, 30, 15, 0.85) 49%, rgba(40, 30, 15, 0.85) 51%, transparent 51%);
  }
  .vit-7 {
    background: radial-gradient(ellipse 100% 70% at 50% 100%,
      rgba(255, 235, 175, 1) 0%,
      rgba(224, 169, 74, 0.95) 25%,
      rgba(160, 74, 88, 0.9) 50%,
      rgba(74, 111, 168, 0.95) 75%,
      rgba(20, 35, 65, 1) 100%);
    position: relative;
  }
  .vit-7::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 100%, transparent 28%, rgba(40, 30, 15, 0.8) 28%, rgba(40, 30, 15, 0.8) 30%, transparent 30%),
      linear-gradient(90deg, transparent 49%, rgba(40, 30, 15, 0.7) 49%, rgba(40, 30, 15, 0.7) 51%, transparent 51%);
  }

  /* Reveal animations */
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .reveal[data-delay="1"] { transition-delay: 0.08s; }
  .reveal[data-delay="2"] { transition-delay: 0.16s; }
  .reveal[data-delay="3"] { transition-delay: 0.24s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    html { scroll-behavior: auto; }
  }
</style>
